# Copy to backend/.env and fill in. Never commit the real file.

# development | production  (production disables /docs and /redoc)
ENV=development

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API. The service-role key is server-only: never put it
# in frontend code or a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private bucket created by supabase/migrations/0001_init.sql
SUPABASE_BUCKET=violation-screenshots

# --- API --------------------------------------------------------------------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
# Detection requests per user per minute
RATE_LIMIT_PER_MINUTE=30
# Lifetime of screenshot links handed to the browser
SIGNED_URL_TTL_SECONDS=300
# Temporary upload folder (files are deleted after processing)
UPLOAD_DIR=uploads

# --- Detection --------------------------------------------------------------
PPE_CONFIDENCE=0.4
PERSON_CONFIDENCE=0.4
# A person must be missing an item this long (video time) before a violation
# is logged; one violation per person per continuous episode. Images log at once.
VIOLATION_WINDOW_SECONDS=2
# ... and an episode ends after this long without the item missing
VIOLATION_CLEAR_SECONDS=1
# Person tracker for video: bytetrack | botsort
TRACKER=bytetrack

# --- Network cameras ----------------------------------------------------------
# Encrypts camera usernames/passwords at rest. Required to save credentials.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Keep it safe: losing or changing it means re-entering every camera's credentials.
CAMERA_SECRET_KEY=
# URL schemes cameras may use. Add http,https only if you need MJPEG cameras.
STREAM_ALLOWED_SCHEMES=rtsp,rtsps
# Default frames analysed per second for a new camera
STREAM_SAMPLE_FPS=5
# Start the cameras marked enabled when the backend starts
STREAM_AUTOSTART=true

# --- Privacy and retention (services/privacy.py) -------------------------------
# Pixelate every detected person in stored screenshots (labels stay readable)
PRIVACY_BLUR=true
# Keeps the unblurred original, encrypted, so an admin can check a disputed
# record (every view is audited). Empty = no originals are kept at all.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EVIDENCE_SECRET_KEY=
# ... for this long (0 = never keep originals)
ORIGINAL_RETENTION_HOURS=72
# Screenshots (and leftover upload files) older than this are deleted, except
# records on legal hold. The violation rows and their hashes are kept.
RETENTION_DAYS=30
# How often the deletion job runs inside the backend (0 = off; then run
# services.privacy.run_retention() from cron instead)
RETENTION_INTERVAL_MINUTES=60

# --- Reports ------------------------------------------------------------------
# IANA time zone of the site: days and shifts in the dashboard and weekly report
SITE_TIMEZONE=Asia/Kolkata
# Shifts in site time; a shift may run past midnight
SHIFTS=A=06:00-14:00,B=14:00-22:00,C=22:00-06:00

# --- Alerts (services/alerts.py) ------------------------------------------------
# Recipients are managed on the Alerts page. Sources that send alerts
# (camera, video, image; empty = none):
ALERT_SOURCES=camera
# The frontend's address, for the link in each alert
APP_BASE_URL=http://localhost:5173
# Webhook alerts are signed with HMAC-SHA256 (X-SafeVision-Signature) if set
ALERT_WEBHOOK_SECRET=
# WhatsApp: meta | twilio, or empty to use whichever has credentials. With no
# credentials, WhatsApp alerts are written to the backend log instead.
WHATSAPP_PROVIDER=
# Meta WhatsApp Cloud API (developers.facebook.com -> WhatsApp -> API Setup)
WHATSAPP_META_TOKEN=
WHATSAPP_META_PHONE_NUMBER_ID=
# Twilio (console.twilio.com); FROM is your WhatsApp-enabled number, +E.164
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=

# --- Model weights ------------------------------------------------------------
# Relative paths are resolved from backend/. Leave a path empty to use the best
# available file listed in backend/weights.py (same defaults as the CLI scripts):
#   PPE    : 5class_v5d_50epochs, else 5class_v2
#   HELMET : 5class_v5d_50epochs, else v1 (17-class); classes are matched by name
#   PERSON : yolov8n-pose.pt (keypoint head/torso regions), else yolov8n.pt (boxes only)
PPE_MODEL_PATH=
HELMET_MODEL_PATH=
PERSON_MODEL_PATH=
# Optional SHA-256 of each weights file; loading fails if it does not match
PPE_MODEL_SHA256=
HELMET_MODEL_SHA256=
PERSON_MODEL_SHA256=

# Dev-only: skip sign-in, every request acts as an admin. Refused when ENV=production.
AUTH_DISABLED=false

# Dev-only: no database. Detection works but nothing is saved. Needs AUTH_DISABLED=true.
DB_DISABLED=false
