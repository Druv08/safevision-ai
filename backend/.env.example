# Copy to backend/.env and fill in. Never commit the real file.

# development | production  (production disables /docs and /redoc)
ENV=development

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API. The service-role key is server-only: never put it
# in frontend code or a VITE_ variable.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Private bucket created by supabase/migrations/0001_init.sql
SUPABASE_BUCKET=violation-screenshots

# --- API --------------------------------------------------------------------
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=50
# Detection requests per user per minute
RATE_LIMIT_PER_MINUTE=30
# Lifetime of screenshot links handed to the browser
SIGNED_URL_TTL_SECONDS=300
# Temporary upload folder (files are deleted after processing)
UPLOAD_DIR=uploads

# --- Detection --------------------------------------------------------------
PPE_CONFIDENCE=0.4
PERSON_CONFIDENCE=0.4
# Minimum video time between two logged violations of the same type
VIDEO_COOLDOWN_SECONDS=5

# --- Model weights ------------------------------------------------------------
# Relative paths are resolved from backend/. Leave PPE_MODEL_PATH empty to use
# the newest trained run under ai-model/outputs/training-runs/.
PPE_MODEL_PATH=
HELMET_MODEL_PATH=../ai-model/outputs/training-runs/safevision_yolov8n_v1/weights/best.pt
# COCO yolov8n, used only for the person class
PERSON_MODEL_PATH=../yolov8n.pt
# Optional SHA-256 of each weights file; loading fails if it does not match
PPE_MODEL_SHA256=
HELMET_MODEL_SHA256=
PERSON_MODEL_SHA256=

# Dev-only: skip sign-in, every request acts as an admin. Refused when ENV=production.
AUTH_DISABLED=false

# Dev-only: no database. Detection works but nothing is saved. Needs AUTH_DISABLED=true.
DB_DISABLED=false
