# Copy to frontend/.env and fill in. Never commit the real file.
VITE_API_URL=http://127.0.0.1:8000
# Supabase -> Project Settings -> API. Use the anon (public) key ONLY.
# Never put the service-role key in any VITE_ variable: it would ship to the browser.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Dev-only: skip the sign-in page (backend needs AUTH_DISABLED=true too)
VITE_AUTH_DISABLED=false

# Optional: client-side upload limit in MB; keep in step with the backend MAX_UPLOAD_MB (default 50)
# VITE_MAX_UPLOAD_MB=50
